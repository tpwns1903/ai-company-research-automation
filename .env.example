# ============================================================
# .env.example — 환경변수 예시 파일
# 실제 사용 시 이 파일을 복사하여 .env 로 이름을 바꾸고
# 아래 값들을 실제 API 키/설정으로 채워주세요.
# .env 파일은 절대 Git에 커밋하지 마세요! (.gitignore에 추가 필수)
# ============================================================

# ── DART API ─────────────────────────────────────────────────
# https://opendart.fss.or.kr/ 에서 발급
DART_API_KEY=your_dart_api_key_here

# ── LLM API (리포트 생성, 둘 중 하나 이상) ────────────────────
# 키가 없거나 아래 예시 문구 그대로면 LLM 없이 Fallback 리포트를 만든다.
# OpenAI : https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=your_openai_api_key_here
# Gemini : https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your_gemini_api_key_here

# ── 뉴스 API ─────────────────────────────────────────────────
# https://newsapi.org/ 에서 발급 (또는 다른 뉴스 API)
NEWS_API_KEY=your_news_api_key_here

# ── Telegram API ─────────────────────────────────────────────
# https://my.telegram.org/apps 에서 발급
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE=+821012345678

# 수집 대상 텔레그램 공개 채널 (쉼표 구분, JSON 배열 형식)
# TELEGRAM_CHANNELS=["@channel_name_1","@channel_name_2"]

# ── KRX 데이터 포털 (선택) ─────────────────────────────────────
# pykrx 1.2.8+는 PER/PBR/시가총액 조회에 https://data.krx.co.kr 로그인이 필요하다.
# 비워 두면 해당 지표를 네이버 금융에서 보충한다.
KRX_ID=
KRX_PW=

# ── 수집 설정 ─────────────────────────────────────────────────
# 증권사 리포트 수집 기간 (일, 기본 90일 = 3개월)
REPORT_LOOKBACK_DAYS=90

# 뉴스 수집 기간 (일, 기본 30일)
NEWS_LOOKBACK_DAYS=30

# 외부 요청 간 딜레이 (초)
REQUEST_DELAY_SECONDS=1.0

# 텔레그램 채널당 lookback 기간 스캔 시 최대 메시지 수 (안전 상한선)
TELEGRAM_MAX_SCAN_MESSAGES=2000

# 최대 재시도 횟수
MAX_RETRY_ATTEMPTS=3

# 재시도 간 대기 시간 (초)
RETRY_DELAY_SECONDS=2.0

# ── 캐시 설정 ─────────────────────────────────────────────────
# 캐시 유효 기간 (초, 기본 86400 = 24시간)
CACHE_TTL_SECONDS=86400

# 빈 결과([]/{}/None) 캐시 유효 기간 (초, 기본 3600 = 1시간)
# 일시적 오류로 빈 결과가 캐싱되어 재조회를 오래 막는 것을 방지한다.
CACHE_TTL_EMPTY_SECONDS=3600

# ── LLM 설정 ─────────────────────────────────────────────────
# 제공자: auto / openai / gemini
#   auto는 OPENAI_API_KEY → GEMINI_API_KEY 순으로 설정된 키를 사용한다.
LLM_PROVIDER=auto
# 모델명. 비우면 제공자별 기본 모델 (openai: gpt-4o / gemini: gemini-3.8-flash)
LLM_MODEL=
# 추론 모델(Gemini 3 등)은 내부 추론 토큰도 이 한도를 함께 쓰므로 넉넉하게 잡는다.
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.3
# 추론 모델의 추론 강도 (low / medium / high). 비우면 전송하지 않는다.
# gpt-4o처럼 추론 모델이 아니면 비워 둘 것 (값이 있으면 400 에러).
LLM_REASONING_EFFORT=

# ── 로그 설정 ─────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
